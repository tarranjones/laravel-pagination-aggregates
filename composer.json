{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tarranjones/laravel-pagination-aggregates",
    "type": "library",
    "description": "Attach aggregate metadata to Laravel paginated responses",
    "keywords": [
        "laravel",
        "pagination",
        "aggregates",
        "eloquent"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/pagination": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.3",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^10.9 || ^11.0",
        "pestphp/pest": "^4.4 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.1 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "TarranJones\\LaravelPaginationAggregates\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest --compact"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "format": [
            "@php vendor/bin/pint"
        ],
        "rector": [
            "@php vendor/bin/rector"
        ],
        "lint": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/rector --dry-run",
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "check": [
            "@lint",
            "@test"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi"
    },
    "extra": {
        "laravel": {
            "providers": [
                "TarranJones\\LaravelPaginationAggregates\\PaginationAggregatesServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
